{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@android": ["./android/*"],
      "@ios": ["./ios/*"]
    }
  },
  "exclude": ["node_modules", "logica"],
  "include": [
    "neup/**/*.ts",
    "neup/**/*.tsx",
    "neup/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    
  ]
}
