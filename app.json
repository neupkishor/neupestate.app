{
  "expo": {
    "name": "Neup.Estate",
    "slug": "estate",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic", 
    "scheme": "neupestate",
    "plugins": [
      ["expo-router"],
      ["expo-secure-store"],
      ["expo-splash-screen",{
        "backgroundColor": "#EFEFEF",
        "image": "./base/images/icon.png",
        "resizeMode": "cover",
        "dark": {
          "backgroundColor": "#444444",
          "image": "./base/images/icon.png"
        }
      }]
    ],
    "orientation": "portrait",
    "icon": "./base/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neup.estate"
    },
    "android": {
      "package": "com.neup.estate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./base/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c153da2-d6aa-449a-894f-0dee028004ca"
      }
    }
  }
}
