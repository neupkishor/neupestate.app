{
  "name": "com.neup.estate",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "directories": {
    "lib": "@neup"
  },
  "dependencies": {
    "expo": "^58.0.17",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.8",
    "expo-file-system": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup": "chmod +x ./setup.sh && ./setup.sh",
    "eas-build-pre-install": "bash ./setup.sh",
    "start": "npm run setup && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "npx expo prebuild --clean && ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" ANDROID_SDK_ROOT=\"${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}\" sh -c 'mkdir -p generated/and.version && npx eas-cli build --platform android --profile production --local --output generated/and.version/app-release.aab'",
    "build:android.apk": "node ./build-android-apk.cjs",
    "install:android": "npm run build:android.apk && ANDROID_HOME=\"${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}\" bundletool install-apks --apks=generated/and.version/app-release.apks",
    "build:ios": "mkdir -p generated/ios.version && npx eas build --platform ios --profile production --local --output generated/ios.version/app-release.ipa"
  },
  "private": true
}
