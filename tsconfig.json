{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/neup/*": ["./.neup/*"],
      "@/base/*": ["./.neup/base/*"],
      "@android": ["./android/*"],
      "@ios": ["./ios/*"]
    }
  },
  "exclude": ["node_modules", "logica"],
  "include": [
    ".neup/**/*.ts",
    ".neup/**/*.tsx",
    ".neup/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    
  ]
}
