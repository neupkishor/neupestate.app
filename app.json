{
  "expo": {
    "name": "Estate",
    "slug": "estate",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "scheme": "neupestate",
    "plugins": [
      "./plugins/withAndroidReleaseOptimization",
      [
        "expo-router"
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFEFEF",
          "image": "./.neup/base/images/icon.png",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#444444",
            "image": "./.neup/base/images/icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "orientation": "portrait",
    "icon": "./.neup/base/images/appicon.default.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neup.estate"
    },
    "android": {
      "package": "com.neup.estate",
      "adaptiveIcon": {
        "foregroundImage": "./.neup/base/images/appicon.adaptive.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./.neup/base/images/appicon.adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./.neup/base/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c153da2-d6aa-449a-894f-0dee028004ca"
      }
    }
  }
}
